# Copy this file to .env.vps on the VPS and fill in strong secrets.

FRONTEND_DEPLOY_HOST=play.ideashop.zeacrm.com
BACKEND_DEPLOY_HOST=api.symphozen.zeacrm.com
PRESENCE_DEPLOY_HOST=presence.ideashop.zeacrm.com

VITE_API_BASE_URL=https://api.symphozen.zeacrm.com/api
VITE_API_URL=https://api.symphozen.zeacrm.com/api
VITE_PRESENCE_URL=https://presence.ideashop.zeacrm.com

POSTGRES_DB=vee_task_manager
POSTGRES_USER=vee_user
POSTGRES_PASSWORD=change_this_database_password

VEE_JWT_SECRET_KEY=change_this_to_a_long_random_secret
VEE_JWT_REFRESH_SECRET_KEY=change_this_to_a_different_long_random_secret
VEE_CORS_ALLOW_ORIGINS=["https://play.ideashop.zeacrm.com","https://api.symphozen.zeacrm.com","http://localhost:4200"]

VEE_WEBHOOK_SCHEMA_SYNC_ON_STARTUP=false
REPORTING_WORKER_INTERVAL=60

# Optional media/storage integrations. Fill only if this deployment uses them.
VEE_MEDIA_PUBLIC_BASE=https://api.symphozen.zeacrm.com/uploads
VEE_SUPABASE_URL=https://your-project-id.supabase.co
VEE_SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
VEE_SUPABASE_BUCKET=media
VEE_SUPABASE_PUBLIC_URL=https://your-project-id.supabase.co/storage/v1/object/public/media/
VEE_GOOGLE_CLIENT_EMAIL=your-service-account@project-id.iam.gserviceaccount.com
VEE_GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
VEE_GOOGLE_DRIVE_FOLDER_ID=your-root-folder-id
VEE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VEE_GOOGLE_CLIENT_SECRET=your-client-secret
VEE_GOOGLE_REDIRECT_URI=https://api.symphozen.zeacrm.com/media/google/callback
VEE_MINIO_ENDPOINT=https://zbucket.urlfactory.website
VEE_MINIO_ACCESS_KEY=change_this_if_used
VEE_MINIO_SECRET_KEY=change_this_if_used
VEE_MINIO_REGION=us-east-1
VEE_MINIO_BUCKET_ATTACHMENTS=zea-play-attachments
VEE_MINIO_PUBLIC_BASE=https://zbucket.urlfactory.website
